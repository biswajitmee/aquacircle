# Reference only: enter values in Netlify > Project configuration > Environment variables.
# Netlify Forms stores submissions and sends notifications without SMTP/API secrets.
# Enable Forms detection and add info.aquacircle@gmail.com under Forms > Submission notifications.
# Confirm that recipient in Gmail if Netlify requests confirmation. See README.md.
# Use Builds + Functions scopes (or all scopes). Never put real secrets in this file.
# Use the exact live HTTPS origin, without a trailing slash. Before connecting your
# custom domain, replace this with your actual https://YOUR-SITE.netlify.app URL.
SITE_URL=https://aquacircle.in
LOCAL_DEVELOPMENT=0
# Existing Geoapify key, available to Functions. Used for maps and reverse lookup.
# Keep secret. No browser/public map key is needed. Review Geoapify usage quotas.
GEOAPIFY_API_KEY=
# Also set in netlify.toml; changes to this public provider selector require a rebuild.
NEXT_PUBLIC_ENQUIRY_PROVIDER=netlify
# PostgreSQL, SMTP and RATE_LIMIT_SECRET are needed only for the optional standalone API.
# Do not remove an existing legacy database until its pending enquiries have been handled.

# Optional public contact information. Rebuild after changing these values.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_WORKING_HOURS=
