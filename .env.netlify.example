# Reference only: enter real values in Netlify > Project configuration > Environment variables.
# Use Builds + Functions scopes (or all scopes). Never put real secrets in this file.
# Use the exact live HTTPS origin, without a trailing slash. Before connecting your
# custom domain, replace this with your actual https://YOUR-SITE.netlify.app URL.
SITE_URL=https://aquacircle.in
LOCAL_DEVELOPMENT=0

# Required: hosted PostgreSQL connection string, with TLS. Prefer a pooled endpoint.
# The database must permit the app to create its tables and indexes on first use.
DATABASE_URL=

# Required: your SMTP provider's real settings and verified sender.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
BUSINESS_NOTIFICATION_EMAIL=
SEND_CUSTOMER_ACKNOWLEDGEMENT=false

# Required: generate a private random secret, for example with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
TRUST_PROXY=false
ENQUIRY_RETENTION_DAYS=180

# Optional public contact information. Rebuild after changing these values.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_WORKING_HOURS=
