# Copy to .env.local for local development. These values are local only.
SITE_URL=http://localhost:3000
LOCAL_DEVELOPMENT=1
LOCAL_DATABASE_PATH=.data/aquacircle
# Optional maps + reverse geocoding. Server-only; never prefix with NEXT_PUBLIC_.
# The map uses the same Geoapify key through a bounded tile proxy.
GEOAPIFY_API_KEY=
# Production: unset LOCAL_DEVELOPMENT; use PostgreSQL with TLS and backups.
DATABASE_URL=
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=AquaCircle <requests@aquacircle.test>
BUSINESS_NOTIFICATION_EMAIL=business@aquacircle.test
SEND_CUSTOMER_ACKNOWLEDGEMENT=false
# Production requires a long random secret; never expose it to the browser.
RATE_LIMIT_SECRET=
# Only enable behind a trusted proxy which REPLACES x-forwarded-for.
TRUST_PROXY=false
ENQUIRY_RETENTION_DAYS=180
# Set actual verified public contact details; blank fields are omitted.
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_WORKING_HOURS=
